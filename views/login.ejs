<!DOCTYPE html>
<html>
<body>
<link rel="stylesheet" href="/style.css">
<h1>Login</h1>

<form action="/login" method="POST">

    <input
        type="text"
        name="username"
        placeholder="Username"
        required
    >

    <input
        type="password"
        name="password"
        placeholder="Password"
        required
    >

    <button type="submit">Login</button>

</form>

Dont have an account?<a href="/signup">Create one here!!!</a>
<% if (error) { %>
    <script>
        alert("Incorrect username or password");
    </script>
<% } %>

</body>
</html>